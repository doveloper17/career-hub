---
import Layout from '../../layouts/Layout.astro';
import { applications, textFile } from '../../../lib/store.mjs';
import { verify } from '../../../lib/workflow.mjs';
import { markdown, labels } from '../../lib/view';
const app = applications().find(item => item.id === Astro.params.id);
if (!app) return new Response('지원 기록을 찾을 수 없습니다.', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
const representative = app.kind === 'representative';
const title = representative ? app.title! : app.company;
const result = app.revision ? verify(app.id) : null;
const reviewText = textFile(app.dir, 'quality-review.json');
const review = reviewText ? JSON.parse(reviewText) : null;
const currentReview = review && result?.digest === review.digest;
---
<Layout title={title} eyebrow="APPLICATION DOSSIER">
  <a class="back" href={representative ? "/resumes/" : "/applications/"}>← {representative ? "대표 이력서" : "지원별 이력서"}</a><div class="page-heading"><div><span class={`badge ${app.status}`}>{labels[app.status]}</span><h1 class="detail-title">{title}</h1><p>{[app.company, app.position].filter(Boolean).join(" · ") || "회사·포지션 미지정"} · {app.createdAt} · 버전 {app.revision}</p></div>{app.revision > 0 && <a class="button dark" href={`/applications/${app.id}/resume.md`} download>Markdown 다운로드 ↓</a>}</div>
  <div class="detail-grid"><div><div class="document-nav"><a href="#resume">이력서</a><a href="#jd">JD 원문</a><a href="#strategy">작성 전략</a><a href={`/compare/#${app.id}`}>출처 비교 ↗</a></div><section class="panel article-body" id="resume"><div class="section-title"><h2>{representative ? "대표 이력서" : "맞춤 이력서"}</h2><span class="overline">RESUME / V{app.revision}</span></div><div class="prose" set:html={markdown(textFile(app.dir, 'resume.md') || '아직 생성하지 않았습니다. CLI에서 generate 명령으로 작성하세요.')}></div></section><details class="panel article-body" id="jd" open><summary>채용공고 원문</summary><div class="prose" set:html={markdown(textFile(app.dir, 'jd-raw.md') || '연결된 JD가 없는 대표 이력서입니다.')}></div></details><details class="panel article-body" id="strategy"><summary>JD 연결과 작성 전략</summary><div class="prose" set:html={markdown(textFile(app.dir, 'jd-analysis.md') + '\n' + textFile(app.dir, 'tailoring-plan.md'))}></div></details></div><aside><section class="panel side-detail"><h3>검토 체크포인트</h3><ul class="check-list"><li><span>{result?.passed ? '✓' : '○'}</span>출처·원문 일치 검사 <small>{result ? result.passed ? '통과' : '수정 필요' : '미실행'}</small></li><li><span>{currentReview ? '✓' : '○'}</span>품질·맞춤법 리뷰 <small>{currentReview ? review.verdict : '리뷰 필요'}</small></li><li><span>{app.approval && result?.digest === app.approval.digest ? '✓' : '○'}</span>사람 최종 승인 <small>{app.approval && result?.digest === app.approval.digest ? app.approval.by : '승인 대기'}</small></li></ul>{result && !result.passed && <ul class="error-list">{result.errors.map(e => <li>{e}</li>)}</ul>}<p class="small-note">기계 검사는 확인된 문장과의 일치를 확인합니다. 한국어 맞춤법과 채용 관점 평가는 별도 리뷰가 필요합니다.</p></section><section class="panel side-detail"><h3>{representative ? "대표 이력서 정보" : "지원 정보"}</h3><dl><dt>마감일</dt><dd>{app.deadline || '미지정'}</dd><dt>관심 키워드</dt><dd class="tags">{app.keywords.map(k => <span>{k}</span>)}</dd><dt>공고 출처</dt><dd>{app.jdUrl ? <a href={app.jdUrl} rel="noreferrer">원문 열기 ↗</a> : textFile(app.dir, 'jd-raw.md').trim() ? '직접 입력' : '연결 없음'}</dd></dl></section>{review && <section class="panel side-detail"><h3>리뷰 메모</h3><p>{review.notes}</p><small>{review.reviewer}{!currentReview && ' · 이전 버전 리뷰'}</small></section>}</aside></div>
</Layout>
