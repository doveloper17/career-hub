---
import Layout from '../../layouts/Layout.astro';
import { applications, textFile } from '../../../lib/store.mjs';
import { submissionState } from '../../../lib/workflow.mjs';
import { markdown, labels } from '../../lib/view';
const app = applications().find(item => item.id === Astro.params.id);
if (!app) return new Response('지원 기록을 찾을 수 없습니다.', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
const representative = app.kind === 'representative';
const title = representative ? app.title! : app.company;
const state = submissionState(app.id);
const result = app.revision ? state : null;
const review = state.review;
const currentReview = !!review && state.digest === review.digest;
---
<Layout title={title} eyebrow="APPLICATION DOSSIER">
  <a class="back" href={representative ? "/resumes/" : "/applications/"}>← {representative ? "대표 이력서" : "지원별 이력서"}</a><div class="page-heading"><div><span class={`badge ${state.status}`}>{labels[state.status]}</span><h1 class="detail-title">{title}</h1><p>{[app.company, app.position].filter(Boolean).join(" · ") || "회사·포지션 미지정"} · {app.createdAt} · 버전 {app.revision}</p></div>{state.downloadable && <a class="button dark" href={`/applications/${app.id}/resume.md`} download>승인본 다운로드 ↓</a>}</div>
  {!state.downloadable && <p class="bottom-note" role="status">검토용 초안 · 제출용 다운로드 잠김 — 원본 검증·PASS 리뷰·현재 버전 사람 승인 후에만 이력서를 내려받을 수 있습니다.</p>}
  <div class="detail-grid"><div><div class="document-nav"><a href="#resume">이력서</a><a href="#jd">JD 원문</a><a href="#strategy">작성 전략</a><a href={`/compare/#${app.id}`}>출처 비교 ↗</a></div><section class="panel article-body" id="resume"><div class="section-title"><h2>{representative ? "대표 이력서" : "맞춤 이력서"}</h2><span class="overline">RESUME / V{app.revision}</span></div><div class="prose" set:html={markdown(textFile(app.dir, 'resume.md') || '아직 생성하지 않았습니다. CLI에서 generate 명령으로 작성하세요.')}></div></section><details class="panel article-body" id="jd" open><summary>채용공고 원문</summary><div class="prose" set:html={markdown(textFile(app.dir, 'jd-raw.md') || '연결된 JD가 없는 대표 이력서입니다.')}></div></details><details class="panel article-body" id="strategy"><summary>JD 연결과 작성 전략</summary><div class="prose" set:html={markdown(textFile(app.dir, 'jd-analysis.md') + '\n' + textFile(app.dir, 'tailoring-plan.md'))}></div></details></div><aside><section class="panel side-detail"><h3>검토 체크포인트</h3><ul class="check-list"><li><span>{result?.passed ? '✓' : '○'}</span>원본 확인·출처 구조 검사 <small>{result ? result.passed ? '통과' : '수정 필요' : '미실행'}</small></li><li><span>{state.reviewed ? '✓' : currentReview && review?.verdict === 'FAIL' ? '✕' : '○'}</span>사실·품질·맞춤법 리뷰 <small>{currentReview ? review.verdict : '리뷰 필요'}</small></li><li><span>{state.approved ? '✓' : '○'}</span>사람 최종 승인 <small>{state.approved ? app.approval?.by : '승인 대기'}</small></li></ul>{result && !result.passed && <ul class="error-list">{result.errors.map(e => <li>{e}</li>)}</ul>}<p class="small-note">구조 검사는 원본 확인·출처 연결·본문 정합성을 확인합니다. 표현의 사실 보존은 문장별 의미 검토와 독립 품질 리뷰로 확인하며 최종 제출은 사람이 승인합니다.</p></section><section class="panel side-detail"><h3>{representative ? "대표 이력서 정보" : "지원 정보"}</h3><dl><dt>마감일</dt><dd>{app.deadline || '미지정'}</dd><dt>관심 키워드</dt><dd class="tags">{app.keywords.map(k => <span>{k}</span>)}</dd><dt>공고 출처</dt><dd>{app.jdUrl ? <a href={app.jdUrl} rel="noreferrer">원문 열기 ↗</a> : textFile(app.dir, 'jd-raw.md').trim() ? '직접 입력' : '연결 없음'}</dd></dl></section>{review && <section class="panel side-detail"><h3>리뷰 메모</h3><p>{review.notes}</p><small>{review.reviewer}{!currentReview && ' · 이전 버전 리뷰'}</small></section>}</aside></div>
</Layout>
